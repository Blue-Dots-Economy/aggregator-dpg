{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aggregator forms — blue_dot/up-gzb",
  "description": "Form schemas the aggregator renders and validates against. Presentation lives in each schema under x-rjsf. Self-contained: a brand bundle repeats every form it serves, matching how network.json ships.",
  "forms": {
    "coordinator-registration": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://schemas.bluedots.org/aggregator/blue_dot/up-gzb/coordinator-registration.v1.json",
      "title": "Aggregator Registration",
      "description": "UP-GZB variant of the coordinator signup payload. Adds the sub-org / institution name from the Aug 2026 schema review and the `service_provider` aggregator type this network serves. A complete copy, not a partial: the validator compiles one schema with no merge layer. Other deployments keep using config/schemas/aggregator/registration.v1.json.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "contact", "consent"],
      "properties": {
        "name": {
          "type": "string",
          "title": "Organisation Name",
          "minLength": 2,
          "maxLength": 200,
          "examples": ["SkillBridge Network", "TRRAIN", "Pankh Foundation"],
          "x-rjsf": {
            "placeholder": "e.g. SkillBridge Network",
            "autofocus": true
          }
        },
        "type": {
          "type": "string",
          "title": "Aggregator Type",
          "enum": ["seeker", "provider", "service_provider"],
          "x-rjsf": {
            "widget": "select",
            "placeholder": "Select aggregator type",
            "enumNames": ["Seeker", "Provider", "Service Provider"]
          }
        },
        "sub_org_name": {
          "type": "string",
          "title": "Sub-Org / Division / Vertical / Institution Name",
          "description": "Any specific sub-identity needed for identification and tracking. May be the same as the organisation name.",
          "maxLength": 200,
          "examples": ["GarvSe Centre, Ghaziabad"],
          "x-updatable": true,
          "x-rjsf": {
            "placeholder": "e.g. GarvSe Centre, Ghaziabad"
          }
        },
        "url": {
          "type": "string",
          "title": "Website",
          "format": "uri",
          "maxLength": 2048,
          "examples": ["https://skillbridge.in"],
          "x-updatable": true,
          "x-rjsf": {
            "placeholder": "https://yourorg.in",
            "options": {
              "inputType": "url"
            }
          }
        },
        "locations": {
          "type": "array",
          "title": "Location",
          "maxItems": 1,
          "x-updatable": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["geo", "address"],
            "properties": {
              "geo": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "coordinates"],
                "default": {
                  "type": "Point",
                  "coordinates": [0, 0]
                },
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "Point",
                      "LineString",
                      "Polygon",
                      "MultiPoint",
                      "MultiLineString",
                      "MultiPolygon",
                      "GeometryCollection"
                    ],
                    "default": "Point",
                    "x-rjsf": {
                      "widget": "hidden"
                    }
                  },
                  "coordinates": {
                    "type": "array",
                    "default": [0, 0],
                    "x-rjsf": {
                      "widget": "hidden"
                    }
                  }
                },
                "x-rjsf": {
                  "widget": "hidden",
                  "title": ""
                }
              },
              "address": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "streetAddress": {
                    "type": "string",
                    "title": "Street",
                    "x-rjsf": {
                      "placeholder": "Street"
                    }
                  },
                  "addressLocality": {
                    "type": "string",
                    "title": "City",
                    "x-rjsf": {
                      "placeholder": "City"
                    }
                  },
                  "addressRegion": {
                    "type": "string",
                    "title": "State",
                    "x-rjsf": {
                      "placeholder": "State"
                    }
                  },
                  "postalCode": {
                    "type": "string",
                    "title": "PIN code",
                    "x-rjsf": {
                      "placeholder": "PIN"
                    }
                  },
                  "addressCountry": {
                    "type": "string",
                    "title": "Country",
                    "minLength": 1,
                    "x-rjsf": {
                      "placeholder": "India"
                    }
                  }
                },
                "x-rjsf": {
                  "layout": "grid",
                  "order": [
                    "streetAddress",
                    "addressLocality",
                    "addressRegion",
                    "postalCode",
                    "addressCountry"
                  ],
                  "title": ""
                }
              }
            },
            "x-rjsf": {
              "layout": "stack",
              "order": ["address", "geo"],
              "title": ""
            }
          },
          "x-rjsf": {
            "options": {
              "addable": true,
              "removable": true,
              "orderable": false,
              "itemLabel": "Location"
            }
          }
        },
        "contact": {
          "type": "object",
          "title": "Primary Contact",
          "additionalProperties": false,
          "required": ["name", "phone", "email"],
          "properties": {
            "name": {
              "type": "string",
              "title": "Contact Name",
              "minLength": 2,
              "maxLength": 200,
              "examples": ["Rajesh Kumar"],
              "x-rjsf": {
                "placeholder": "Full name of the primary contact"
              }
            },
            "phone": {
              "type": "string",
              "title": "Phone",
              "pattern": "^(\\+?\\d{10,15}|\\d{10})$",
              "examples": ["+919876543210", "9876543210"],
              "x-rjsf": {
                "placeholder": "+91 98765 43210",
                "options": {
                  "inputType": "tel"
                }
              }
            },
            "email": {
              "type": "string",
              "title": "Email",
              "format": "email",
              "maxLength": 320,
              "examples": ["admin@skillbridge.in"],
              "x-rjsf": {
                "placeholder": "admin@yourorg.in",
                "options": {
                  "inputType": "email"
                }
              }
            }
          },
          "x-rjsf": {
            "layout": "grid",
            "order": ["name", "phone", "email"]
          }
        },
        "consent": {
          "type": "object",
          "title": "Terms & Privacy Consent",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {
            "value": {
              "type": "boolean",
              "title": "I have read and accept the terms and privacy policy",
              "x-rjsf": {
                "widget": "ConsentCheckbox"
              }
            },
            "given_at": {
              "type": "string",
              "format": "date-time",
              "x-rjsf": {
                "widget": "hidden",
                "options": {
                  "label": false
                }
              }
            },
            "valid_till": {
              "type": "string",
              "format": "date-time",
              "x-rjsf": {
                "widget": "hidden",
                "options": {
                  "label": false
                }
              }
            }
          },
          "x-rjsf": {
            "layout": "stack",
            "order": ["value", "given_at", "valid_till"]
          }
        }
      },
      "x-rjsf": {
        "layout": "stack",
        "order": ["name", "type", "sub_org_name", "url", "contact", "locations", "consent"]
      }
    },
    "org-registration": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://schemas.bluedots.org/aggregator/blue_dot/up-gzb/org-registration.v1.json",
      "title": "Organisation Registration",
      "description": "UP-GZB variant of the parent-organisation signup payload (spec §6.1). Adds the organisation classification, management type, address and aggregator-type fields from the Aug 2026 schema review on top of the shared default. A complete copy, not a partial: the validator compiles one schema with no merge layer. Other deployments keep using config/schemas/aggregator/org-registration.v1.json.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "aggregator_type",
        "organisation_type",
        "management_type",
        "owner",
        "consent"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "title": "Organisation Name",
          "minLength": 2,
          "maxLength": 200,
          "examples": ["Enable India", "Pankh Foundation"],
          "x-rjsf": {
            "placeholder": "e.g. Enable India",
            "autofocus": true
          }
        },
        "state": {
          "type": "string",
          "title": "State",
          "description": "Derived from the address block on this instance; not asked for separately.",
          "maxLength": 200,
          "examples": ["Uttar Pradesh"],
          "x-rjsf": {
            "widget": "hidden",
            "options": {
              "label": false
            }
          }
        },
        "website": {
          "type": "string",
          "title": "Website",
          "format": "uri",
          "maxLength": 2048,
          "description": "Not required at signup; can be added or edited later.",
          "examples": ["https://enableindia.org"],
          "x-updatable": true,
          "x-rjsf": {
            "placeholder": "https://yourorg.org",
            "options": {
              "inputType": "url"
            }
          }
        },
        "aggregator_type": {
          "type": "array",
          "title": "Aggregator Type",
          "description": "Which participants this organisation represents. Captured as information only — it does not restrict what its coordinators can do.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["seeker", "provider", "service_provider"]
          },
          "examples": [["seeker"], ["provider", "service_provider"]],
          "x-rjsf": {
            "widget": "checkboxes",
            "enumNames": ["Seekers", "Job Providers", "Service Providers"],
            "options": {
              "inline": true
            }
          }
        },
        "organisation_type": {
          "type": "string",
          "title": "Organisation Type",
          "description": "The broad category that describes your organisation.",
          "enum": ["educational", "non_educational"],
          "x-rjsf": {
            "widget": "select",
            "placeholder": "Select organisation type",
            "enumNames": ["Educational", "Non-Educational"]
          }
        },
        "organisation_sub_type_educational": {
          "type": "string",
          "title": "Organisation Sub-Type",
          "description": "Select the type that best applies.",
          "x-show-if": {
            "organisation_type": ["educational"]
          },
          "enum": [
            "school",
            "pu_college",
            "college",
            "iti",
            "other_vocational_training",
            "polytechnic",
            "diploma",
            "other"
          ],
          "x-rjsf": {
            "widget": "select",
            "placeholder": "Select sub-type",
            "enumNames": [
              "School",
              "PU College",
              "College",
              "ITI",
              "Other Vocational Training",
              "Polytechnic",
              "Diploma",
              "Other"
            ]
          }
        },
        "organisation_sub_type_non_educational": {
          "type": "string",
          "title": "Organisation Sub-Type",
          "description": "Select the type that best applies.",
          "x-show-if": {
            "organisation_type": ["non_educational"]
          },
          "enum": [
            "employment_exchange",
            "placement_agency",
            "community_group",
            "individual_trainer_counsellor",
            "msme_association",
            "industries_and_commerce_department",
            "other"
          ],
          "x-rjsf": {
            "widget": "select",
            "placeholder": "Select sub-type",
            "enumNames": [
              "Employment Exchange",
              "Placement Agency",
              "Community Group",
              "Individual Trainer / Counsellor",
              "MSME Association",
              "Industries and Commerce Department",
              "Other"
            ]
          }
        },
        "management_type": {
          "type": "string",
          "title": "Management Type",
          "description": "Whether the organisation is privately run, government-operated, or an NGO.",
          "enum": ["private", "government", "ngo", "other"],
          "x-rjsf": {
            "widget": "select",
            "placeholder": "Select management type",
            "enumNames": ["Private", "Government", "NGO", "Other"]
          }
        },
        "address": {
          "type": "object",
          "title": "Address",
          "description": "Street onwards for the organisation.",
          "additionalProperties": false,
          "properties": {
            "streetAddress": {
              "type": "string",
              "title": "Street",
              "maxLength": 300,
              "x-rjsf": {
                "placeholder": "Street, Area"
              }
            },
            "addressLocality": {
              "type": "string",
              "title": "City",
              "maxLength": 200,
              "x-rjsf": {
                "placeholder": "City"
              }
            },
            "addressDistrict": {
              "type": "string",
              "title": "District",
              "maxLength": 200,
              "x-rjsf": {
                "placeholder": "District"
              }
            },
            "addressRegion": {
              "type": "string",
              "title": "State",
              "maxLength": 200,
              "x-rjsf": {
                "placeholder": "State"
              }
            },
            "postalCode": {
              "type": "string",
              "title": "PIN code",
              "maxLength": 20,
              "x-rjsf": {
                "placeholder": "PIN"
              }
            },
            "addressCountry": {
              "type": "string",
              "title": "Country",
              "maxLength": 100,
              "x-rjsf": {
                "placeholder": "India"
              }
            }
          },
          "x-rjsf": {
            "layout": "grid",
            "order": [
              "streetAddress",
              "addressLocality",
              "addressDistrict",
              "addressRegion",
              "postalCode",
              "addressCountry"
            ]
          }
        },
        "owner": {
          "type": "object",
          "title": "Organisation Owner",
          "additionalProperties": false,
          "required": ["name", "phone", "email"],
          "properties": {
            "name": {
              "type": "string",
              "title": "Owner Name",
              "minLength": 2,
              "maxLength": 200,
              "examples": ["Rajesh Kumar"],
              "x-rjsf": {
                "placeholder": "Full name of the organisation owner"
              }
            },
            "phone": {
              "type": "string",
              "title": "Phone",
              "pattern": "^(\\+?\\d{10,15}|\\d{10})$",
              "examples": ["+919876543210", "9876543210"],
              "x-rjsf": {
                "placeholder": "+91 98765 43210",
                "options": {
                  "inputType": "tel"
                }
              }
            },
            "email": {
              "type": "string",
              "title": "Email",
              "format": "email",
              "maxLength": 320,
              "examples": ["owner@enableindia.org"],
              "x-rjsf": {
                "placeholder": "owner@yourorg.org",
                "options": {
                  "inputType": "email"
                }
              }
            }
          },
          "x-rjsf": {
            "layout": "grid",
            "order": ["name", "phone", "email"]
          }
        },
        "consent": {
          "type": "object",
          "title": "Terms & Privacy Consent",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {
            "value": {
              "type": "boolean",
              "title": "I have read and accept the terms and privacy policy",
              "x-rjsf": {
                "widget": "ConsentCheckbox"
              }
            },
            "given_at": {
              "type": "string",
              "format": "date-time",
              "x-rjsf": {
                "widget": "hidden",
                "options": {
                  "label": false
                }
              }
            },
            "valid_till": {
              "type": "string",
              "format": "date-time",
              "x-rjsf": {
                "widget": "hidden",
                "options": {
                  "label": false
                }
              }
            }
          },
          "x-rjsf": {
            "layout": "stack",
            "order": ["value", "given_at", "valid_till"]
          }
        }
      },
      "x-rjsf": {
        "layout": "stack",
        "order": [
          "display_name",
          "website",
          "aggregator_type",
          "organisation_type",
          "organisation_sub_type_educational",
          "organisation_sub_type_non_educational",
          "management_type",
          "address",
          "state",
          "owner",
          "consent"
        ]
      }
    },
    "profile": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://schemas.bluedots.org/aggregator/blue_dot/up-gzb/profile.v1.json",
      "title": "Aggregator Profile",
      "description": "Post-login profile completion payload. Captures who the aggregator is, what they want from the network, and what they bring to it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["who_i_am", "what_i_want", "what_i_have"],
      "properties": {
        "who_i_am": {
          "type": "object",
          "title": "Who I Am",
          "additionalProperties": false,
          "required": ["display_name", "address"],
          "properties": {
            "display_name": {
              "type": "string",
              "title": "Display Name",
              "description": "Public display name shown on the network.",
              "minLength": 2,
              "maxLength": 200,
              "x-rjsf": {
                "placeholder": "Public display name"
              }
            },
            "address": {
              "type": "string",
              "title": "Office Address",
              "minLength": 5,
              "maxLength": 500,
              "x-rjsf": {
                "widget": "textarea",
                "options": {
                  "rows": 3
                }
              }
            },
            "logo_url": {
              "type": "string",
              "title": "Logo URL",
              "format": "uri",
              "maxLength": 500,
              "x-rjsf": {
                "placeholder": "https://...",
                "options": {
                  "inputType": "url"
                }
              }
            }
          }
        },
        "what_i_want": {
          "type": "object",
          "title": "What I Want",
          "additionalProperties": false,
          "required": ["beneficiary_groups", "geographies"],
          "properties": {
            "beneficiary_groups": {
              "type": "array",
              "title": "Beneficiary Groups",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "minItems": 1,
              "maxItems": 12,
              "x-rjsf": {
                "options": {
                  "addable": true,
                  "removable": true
                }
              }
            },
            "geographies": {
              "type": "array",
              "title": "Geographies Served",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "minItems": 1,
              "maxItems": 36,
              "x-rjsf": {
                "options": {
                  "addable": true,
                  "removable": true
                }
              }
            },
            "sectors": {
              "type": "array",
              "title": "Sectors of Interest",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "maxItems": 24,
              "x-rjsf": {
                "options": {
                  "addable": true,
                  "removable": true
                }
              }
            }
          }
        },
        "what_i_have": {
          "type": "object",
          "title": "What I Have",
          "additionalProperties": false,
          "required": ["network_size"],
          "properties": {
            "network_size": {
              "type": "integer",
              "title": "Approximate Network Size",
              "minimum": 0,
              "maximum": 10000000,
              "x-rjsf": {
                "placeholder": "0"
              }
            },
            "capabilities": {
              "type": "array",
              "title": "Capabilities Offered",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "maxItems": 24,
              "x-rjsf": {
                "options": {
                  "addable": true,
                  "removable": true
                }
              }
            }
          }
        },
        "consent": {
          "type": "object",
          "title": "Consent",
          "additionalProperties": false,
          "properties": {
            "profile_creation": {
              "type": "boolean",
              "title": "Profile creation & representation",
              "x-rjsf": {
                "widget": "checkbox"
              }
            },
            "data_sharing": {
              "type": "boolean",
              "title": "Sharing information with relevant parties",
              "x-rjsf": {
                "widget": "checkbox"
              }
            },
            "notifications": {
              "type": "boolean",
              "title": "Receive notifications",
              "x-rjsf": {
                "widget": "checkbox"
              }
            },
            "analytics": {
              "type": "boolean",
              "title": "Anonymous analytics",
              "x-rjsf": {
                "widget": "checkbox"
              }
            },
            "marketing": {
              "type": "boolean",
              "title": "Marketing communications",
              "x-rjsf": {
                "widget": "checkbox"
              }
            },
            "retention": {
              "type": "boolean",
              "title": "Data retention per policy",
              "x-rjsf": {
                "widget": "checkbox"
              }
            }
          }
        }
      },
      "x-rjsf": {
        "order": ["who_i_am", "what_i_want", "what_i_have", "consent"]
      }
    }
  }
}
