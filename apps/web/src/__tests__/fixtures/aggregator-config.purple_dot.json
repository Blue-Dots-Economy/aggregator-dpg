    }
  },
  "network": {
    "id": "purple_dot",
    "display_name": "Purple Dot"
  },
  "domains": [
    {
      "id": "seeker",
      "label": "Seekers",
      "plural_label": "Seekers",
      "item_type": "profile_1.0",
      "guardian_consent_required": true,
      "go_live_required": ["schema_required", "consent_required"],
      "dashboardTiles": {
        "profile": [
          {
            "field": "total_items",
            "label": "Profiles Registered"
          },
          {
            "field": "complete_profiles",
            "label": "Profiles Complete"
          },
          {
            "field": "has_applications",
            "label": "Made Connections"
          }
        ],
        "user": [
          {
            "field": "total_users",
            "label": "Total Seekers"
          },
          {
            "field": "avg_items_per_user",
            "label": "Avg Profiles per User"
          },
          {
            "field": "avg_actions_per_user",
            "label": "Avg Actions per User"
          }
        ]
      },
      "status_rules": [
        {
          "status": "new",
          "label": "New",
          "description": "Joined within the last 7 days",
          "when": {
            "item_age_days": {
              "lte": 7
            }
          }
        },
        {
          "status": "active",
          "label": "Active",
          "description": "Connected with a provider in the last 30 days",
          "when": {
            "days_since_last": {
              "buckets": ["create", "accept"],
              "lte": 30
            }
          }
        },
        {
          "status": "at_risk",
          "label": "At Risk",
          "description": "No activity for 30\u201390 days",
          "when": {
            "days_since_last": {
              "buckets": ["create", "accept", "reject"],
              "between": [31, 90]
            }
          }
        },
        {
          "status": "inactive",
          "label": "Inactive",
          "description": "No activity 90+ days",
          "when": "default"
        }
      ]
    },
    {
      "id": "provider",
      "label": "Service Providers",
      "plural_label": "Service Providers",
      "item_type": "profile_1.0",
      "guardian_consent_required": false,
      "go_live_required": ["schema_required", "consent_required"],
      "dashboardTiles": {
        "profile": [
          {
            "field": "total_items",
            "label": "Profiles Registered"
          },
          {
            "field": "complete_profiles",
            "label": "Profiles Complete"
          },
          {
            "field": "has_applications",
            "label": "Received Connections"
          }
        ],
        "user": [
          {
            "field": "total_users",
            "label": "Total Service Providers"
          },
          {
            "field": "avg_items_per_user",
            "label": "Avg Profiles per User"
          },
          {
            "field": "avg_actions_per_user",
            "label": "Avg Actions per User"
          }
        ]
      },
      "status_rules": [
        {
          "status": "new",
          "label": "New",
          "description": "Service posted within the last 7 days",
          "when": {
            "item_age_days": {
              "lte": 7
            }
          }
        },
        {
          "status": "active",
          "label": "Active",
          "description": "Accepted or rejected a request in the last 30 days",
          "when": {
            "all": [
              {
                "count": {
                  "buckets": ["create"],
                  "gt": 0
                }
              },
              {
                "days_since_last": {
                  "buckets": ["accept", "reject"],
                  "lte": 30
                }
              }
            ]
          }
        },
        {
          "status": "at_risk",
          "label": "At Risk",
          "description": "No responses for 30\u201390 days",
          "when": {
            "all": [
              {
                "count": {
                  "buckets": ["create"],
                  "gt": 0
                }
              },
              {
                "days_since_last": {
                  "buckets": ["accept", "reject"],
                  "between": [31, 90]
                }
              }
            ]
          }
        },
        {
          "status": "inactive",
          "label": "Inactive",
          "description": "No activity for 90+ days",
          "when": "default"
        }
      ]
    }
  ],
  "dashboardBuckets": {
    "by_status": {
      "new": "New",
      "active": "Active",
      "at_risk": "At Risk",
      "inactive": "Inactive"
    },
    "by_initiated_action_status": {
      "create": "Requested",
      "accept": "Accepted",
      "reject": "Declined",
      "cancel": "Cancelled"
    },
    "by_received_action_status": {
      "create": "Requests",
      "accept": "Connected",
      "reject": "Declined",
      "cancel": "Cancelled"
    }
  },
  "registration_modes": {
    "voice": {
      "signals_cta": false,
      "label_i18n_key": "registration_mode.voice.label",
      "submission_shape": "account_only",
      "public_hint_i18n_key": "registration_mode.voice.hint"
    },
    "form": {
      "signals_cta": true,
      "label_i18n_key": "registration_mode.form.label",
      "submission_shape": "account_and_profile",
      "public_hint_i18n_key": null
    }
  },
  "signals_ui_urls": {},
  "features": {
    "custom_roles": false
  }
}
