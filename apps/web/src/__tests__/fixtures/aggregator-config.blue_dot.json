    }
  },
  "network": {
    "id": "blue_dot",
    "display_name": "Blue Dot"
  },
  "domains": [
    {
      "id": "seeker",
      "label": "Seekers",
      "plural_label": "Seekers",
      "item_type": "profile_1.0",
      "guardian_consent_required": true,
      "go_live_required": ["schema_required", "consent_required"],
      "dashboardTiles": {
        "profile": [
          {
            "field": "total_items",
            "label": "Profiles Registered"
          },
          {
            "field": "complete_profiles",
            "label": "Profiles Complete"
          },
          {
            "field": "has_applications",
            "label": "Applied for Jobs"
          }
        ],
        "user": [
          {
            "field": "total_users",
            "label": "Total Job Seekers"
          },
          {
            "field": "avg_items_per_user",
            "label": "Avg Profiles per User"
          },
          {
            "field": "avg_actions_per_user",
            "label": "Avg Actions per User"
          }
        ]
      },
      "status_rules": [
        {
          "status": "new",
          "label": "New",
          "description": "Joined within the last 7 days",
          "when": {
            "item_age_days": {
              "lte": 7
            }
          }
        },
        {
          "status": "active",
          "label": "Active",
          "description": "Applied to a job in the last 30 days",
          "when": {
            "days_since_last": {
              "buckets": ["create", "accept"],
              "lte": 30
            }
          }
        },
        {
          "status": "at_risk",
          "label": "At Risk",
          "description": "No applications for 30\u201390 days",
          "when": {
            "days_since_last": {
              "buckets": ["create", "accept", "reject"],
              "between": [31, 90]
            }
          }
        },
        {
          "status": "inactive",
          "label": "Inactive",
          "description": "No activity 90+ days",
          "when": "default"
        }
      ]
    },
    {
      "id": "provider",
      "label": "Providers",
      "plural_label": "Providers",
      "item_type": "job_posting_1.0",
      "guardian_consent_required": false,
      "go_live_required": ["schema_required", "consent_required"],
      "dashboardTiles": {
        "profile": [
          {
            "field": "total_items",
            "label": "Postings Registered"
          },
          {
            "field": "complete_profiles",
            "label": "Postings Complete"
          },
          {
            "field": "has_applications",
            "label": "Received Applications"
          }
        ],
        "user": [
          {
            "field": "total_users",
            "label": "Total Employers"
          },
          {
            "field": "avg_items_per_user",
            "label": "Avg Profiles per User"
          },
          {
            "field": "avg_actions_per_user",
            "label": "Avg Actions per User"
          }
        ]
      },
      "status_rules": [
        {
          "status": "new",
          "label": "New",
          "description": "Job posted within the last 7 days",
          "when": {
            "item_age_days": {
              "lte": 7
            }
          }
        },
        {
          "status": "active",
          "label": "Active",
          "description": "Received applications and shortlisted or rejected in last 30 days",
          "when": {
            "all": [
              {
                "count": {
                  "buckets": ["create"],
                  "gt": 0
                }
              },
              {
                "days_since_last": {
                  "buckets": ["accept", "reject"],
                  "lte": 30
                }
              }
            ]
          }
        },
        {
          "status": "at_risk",
          "label": "At Risk",
          "description": "No applications shortlisted or rejected for 30\u201390 days",
          "when": {
            "all": [
              {
                "count": {
                  "buckets": ["create"],
                  "gt": 0
                }
              },
              {
                "days_since_last": {
                  "buckets": ["accept", "reject"],
                  "between": [31, 90]
                }
              }
            ]
          }
        },
        {
          "status": "inactive",
          "label": "Inactive",
          "description": "No activity for 90+ days",
          "when": "default"
        }
      ]
    }
  ],
  "dashboardBuckets": {
    "by_status": {
      "new": "New",
      "active": "Active",
      "at_risk": "At Risk",
      "inactive": "Inactive"
    },
    "by_initiated_action_status": {
      "create": "Applied",
      "accept": "Accepted",
      "reject": "Rejected",
      "cancel": "Withdrawn"
    },
    "by_received_action_status": {
      "create": "Applications",
      "accept": "Shortlisted",
      "reject": "Rejected",
      "cancel": "Cancelled"
    }
  },
  "registration_modes": {
    "voice": {
      "signals_cta": false,
      "label_i18n_key": "registration_mode.voice.label",
      "submission_shape": "account_only",
      "public_hint_i18n_key": "registration_mode.voice.hint"
    },
    "form": {
      "signals_cta": true,
      "label_i18n_key": "registration_mode.form.label",
      "submission_shape": "account_and_profile",
      "public_hint_i18n_key": null
    }
  },
  "signals_ui_urls": {},
  "features": {
    "custom_roles": false
  }
}
