# ─── Aggregator API — local-dev environment template ────────────────────────
# Copy to apps/api/.env and edit values. Loaded automatically by `pnpm dev`
# (tsx --env-file=.env) and by `pnpm db:migrate`.
#
# Defaults below are a COMPLETE, working set for aggregator-dpg's OWN standalone
# dev compose (Postgres on host :5433, MinIO/Redis/Keycloak/Mailpit on their
# usual localhost ports). Copy, set the few "CHANGE ME" values, and you're done.
#
# Running the unified full-ecosystem stack instead (both DPGs together under
# `local-setup/`)? Only a handful of values differ — see
# local-setup/LOCAL_SETUP.md §6, Step 3.

# ── Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# ── Public URLs (admin/welcome emails + QR registration links)
PUBLIC_API_URL=http://localhost:4000
PUBLIC_PORTAL_URL=http://localhost:3000
PUBLIC_LINK_BASE_URL=http://localhost:3000

# ── Postgres (standalone compose maps host 5433 → container 5432)
DATABASE_URL=postgres://aggregator:aggregator-dev@localhost:5433/aggregator
RUN_MIGRATIONS_ON_BOOT=true

# ── Redis (BullMQ queues)
REDIS_URL=redis://localhost:6379

# ── Keycloak admin (service-account client)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=bluedots
KEYCLOAK_ADMIN_CLIENT_ID=aggregator-api
KEYCLOAK_ADMIN_CLIENT_SECRET=aggregator-api-local-dev-secret
# Token client-scoping (defence-in-depth over issuer-only verify). azp allow-list:
# only tokens whose azp is listed are accepted (user + service paths).
# `campaign-manager` is the external client that calls POST /v1/campaign/export.
KEYCLOAK_ALLOWED_AZP=aggregator-portal,aggregator-api,aggregator-bff
# Client(s) allowed on the campaign-manager routes (export now; email/voice next).
# Overrides KEYCLOAK_ALLOWED_AZP on those routes.
CAMPAIGN_MANAGER_ALLOWED_AZP=campaign-manager
# Opt-in aud check (needs the realm oidc-audience-mapper). Blank = disabled.
KEYCLOAK_EXPECTED_AUDIENCE=

# ── Approval token (HS256). CHANGE ME — must be ≥32 chars. Generate with:
#    openssl rand -hex 32
APPROVAL_TOKEN_SECRET=replace-with-openssl-rand-hex-32-output-at-least-32-chars

# ── Admin recipients for review emails (comma-separated). CHANGE ME.
ADMIN_EMAILS=

# ── Mailer — local dev catches all mail in Mailpit (http://localhost:8025).
# For real email, point SMTP_HOST/PORT at your provider and fill user/password.
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@bluedots.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false


# Recipient for the in-app "Contact support" form. When unset, the form is
# hidden and POST /v1/support returns 503. Sent via the mailer (MAIL_PROVIDER),
# Reply-To = the submitting coordinator. Local mail lands in Mailpit (:8025).
# SUPPORT_EMAIL and SUPPORT_CC_EMAIL each accept multiple comma-separated
# addresses (e.g. hello@bluedotseconomy.org).
SUPPORT_EMAIL=
# Optional CC recipient(s) for the "Contact support" form. Comma-separated
# (e.g. vineela@ekstepplus.org). Leave blank to add no CC.
SUPPORT_CC_EMAIL=

# Support/grievance email rendered into consent copy in place of the
# __SUPPORT_EMAIL__ placeholder the config/**/consent.json files ship. Distinct
# from SUPPORT_EMAIL above (the contact-form recipient). Optional; defaults to
# hello@bluedotseconomy.org when unset.
CONSENT_SUPPORT_EMAIL=

# ── Object storage (bulk uploads + errors.csv). Dev = MinIO on localhost:9000.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aggregator-bulk-uploads
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Campaign PII export (#579). The download link is emailed to the REQUESTING
# AGGREGATOR (resolved from the token's aggregator_id -> contact_email); there
# is no admin-recipient env. Sends via the configured mailer (MAIL_PROVIDER).
# Max item_ids accepted per export request.
CAMPAIGN_EXPORT_MAX_ITEMS=500
# Campaign async-job engine ingress controls (per signalstack org).
CAMPAIGN_EXPORT_SUBMIT_WINDOW_SECONDS=60
CAMPAIGN_EXPORT_SUBMIT_MAX=10
CAMPAIGN_EXPORT_MAX_ACTIVE_PER_ORG=3
CAMPAIGN_EXPORT_ATTEMPTS=3
# ── campaign-manager: non-PII dump download API (#692) ──────
# GET /v1/campaign/dump hands the campaign manager pre-signed URLs for the
# Signals non-PII snapshot, so it no longer needs S3 IAM credentials of its own.
#
# The route is WHOLE-NETWORK: unlike /v1/campaign/{export,email,voice} it is not
# scoped to an org, because the campaign manager's own system calls it and needs
# every aggregator's rows. The calling identity is therefore the ONLY control.
# It reuses CAMPAIGN_MANAGER_ALLOWED_AZP above (same Keycloak client) and then
# additionally requires the token's preferred_username to match the value below,
# which is what separates the client_credentials system token from a
# coordinator's password-grant token on that same client. An empty value falls
# back to the default rather than disabling the check.
CAMPAIGN_DUMP_SERVICE_ACCOUNT=service-account-campaign-manager
# The `signals-s3-export` cron writes three fixed keys into THIS deployment's
# bucket (S3_BUCKET above): [<prefix>/]<network>/<instance_id>/<table>.ndjson.gz
# There is no manifest and no dated run folder, so the key root is configured
# here and never probed — a wrong value 404s rather than serving another dataset.
# <network> comes from aggregator.config.yaml, not from env, so it cannot drift.
# Leave the prefix empty if the cron writes keys starting at <network>/.
CAMPAIGN_DUMP_PREFIX=
# Required for the route to work; unset ⇒ 503 DUMP_NOT_CONFIGURED. One aggregator
# deployment serves exactly one Signals instance, e.g. blue_dot_up.
CAMPAIGN_DUMP_INSTANCE_ID=
# Pre-signed URL lifetime. The caller is a machine that downloads immediately.
CAMPAIGN_DUMP_URL_TTL_SECONDS=600

# ── Config-as-code (network-scoped). Paths are relative to the app dir
# (apps/api) — that's the CWD when you run `pnpm --filter @aggregator-dpg/api
# dev`, so `../../config` reaches the repo-root config/. (In Docker these are
# overridden to the absolute /app/config path.)
SCHEMA_ROOT_DIR=../../config/blue_dot/schemas
AGGREGATOR_CONFIG_PATH=../../config/blue_dot/aggregator.config.yaml

# ── SignalStack outward push (aggregator → signals-dpg).
# Leave SIGNALSTACK_BASE_URL blank to run standalone (push disabled). To enable,
# set the base URL AND fill the admin key + acting-org id from the signals-dpg
# service seed (db:seed:services). See local-setup/LOCAL_SETUP.md §4 / §6.
SIGNALSTACK_BASE_URL=
SIGNALSTACK_ADMIN_KEY=
SIGNALSTACK_ACTING_ORG_ID=
SIGNALSTACK_ITEM_NETWORK=blue_dot

# ── Signals UI hand-off (optional) ───────────────────────────────────────────
# Per-domain Signals UI login URLs as comma-separated `domain=url` pairs. Each
# network domain (see network.json) is fronted by its own Signals UI, so a
# network with N domains needs N entries. Unset => the public registration form
# shows no Signals hand-off.
#
# IMPORTANT: use the Signals **UI** login page, normally <origin>/auth/login.
# Do NOT paste a Keycloak authorization URL here: those embed one-time `state`
# and `code_challenge` values tied to the browser that produced them, so a
# hardcoded one fails for every user. /auth/login mints a valid one per attempt.
#
# Each key must match a domain id from network.json exactly. A key that does
# not (`seekr` for `seeker`) is not an error — the api logs a warning at
# startup naming it, and that domain simply gets no hand-off. Duplicate keys,
# malformed URLs and non-http(s) schemes are all skipped with a warning too;
# a bad entry never fails boot.
# SIGNALS_UI_URLS=seeker=https://signals-seeker.example/auth/login,provider=https://signals-provider.example/auth/login

# ── Onboarding capability allow-list (optional, #637) ────────────────────────
# Comma-separated allow-list of the onboarding capabilities this instance may
# create registration links for. Accepted values today are the network's
# declared registration_modes keys:
#   form   full-profile registration link
#   voice  identity-only (account_only) link, used by the voice flow
#   bulk   RESERVED for a future gate — currently gates NOTHING (see below)
#
# ABSENT => EVERY CAPABILITY IS ENABLED. That is the default and it is exactly
# today's behaviour, so an existing deployment that never sets this is
# unaffected. `form,voice` is therefore identical to leaving it unset.
#
#   AGGREGATOR_ONBOARDING_ENABLED=form         # voice is not offered
#   AGGREGATOR_ONBOARDING_ENABLED=form,voice   # same as unset
#
# BLANK IS NOT "UNSET" — IT IS A LOCKOUT. `AGGREGATOR_ONBOARDING_ENABLED=`,
# `"   "`, or a Helm `| quote` over an empty string are all *present* values
# that name no capability, so they disable ALL onboarding: empty mode dropdown,
# every create-link call 400s. The api logs an ERROR at first config load
# saying so. To enable everything, remove the variable entirely — anything that
# ships this key (compose, a Helm ConfigMap) must omit it when unconfigured
# rather than render an empty string.
#
# `bulk` DOES NOT GATE BULK UPLOAD. Bulk upload stays fully available whatever
# this var says — the gate is consulted only for declared registration_modes
# keys, and `bulk` is not one of them. It is accepted so a ConfigMap can ship
# it ahead of the code, and it is reported at boot as reserved rather than as a
# typo. But because it enables no declared mode, `AGGREGATOR_ONBOARDING_ENABLED=bulk`
# ALONE DISABLES ALL ONBOARDING. Pair it with a real mode (`form,bulk`).
#
# Why an env var and not a key in aggregator.config.yaml: every deployment
# pulls that YAML from the same repo branch, so removing `voice` there would
# disable voice in every environment, production included. This is per-instance.
#
# It gates CREATION ONLY. Registration links that already exist keep resolving
# in their own mode, so an already-printed voice QR carries on working — the
# public resolve path deliberately reads the unfiltered config.
#
# A value naming no declared mode (a typo like `frm`) is logged as a warning at
# first config load and enables nothing; `bulk` gets its own "reserved" warning
# instead. If nothing in the list matches a declared mode the api logs an ERROR
# and no mode is offered at all — it does not fall back to "all enabled",
# because that would hide the typo and silently re-enable what you meant to
# withhold.
#
# Left commented out on purpose — see the blank-is-a-lockout note above. When
# you do enable it, give it a value:
#   AGGREGATOR_ONBOARDING_ENABLED=form
