{
  "name": "@aggregator-dpg/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint --no-warn-ignored .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "spec:dump": "tsx scripts/dump-openapi.ts"
  },
  "dependencies": {
    "@aggregator-dpg/campaign-audit": "workspace:*",
    "@aggregator-dpg/campaign-template": "workspace:*",
    "@aggregator-dpg/config-loader": "workspace:*",
    "@aggregator-dpg/consent-ledger": "workspace:*",
    "@aggregator-dpg/db-schema": "workspace:*",
    "@aggregator-dpg/mailer": "workspace:*",
    "@aggregator-dpg/network-config": "workspace:*",
    "@aggregator-dpg/profile-csv": "workspace:*",
    "@aggregator-dpg/queue": "workspace:*",
    "@aggregator-dpg/rbac": "workspace:*",
    "@aggregator-dpg/schema-loader": "workspace:*",
    "@aggregator-dpg/shared-primitives": "workspace:*",
    "@aggregator-dpg/signalstack-writer": "workspace:*",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/client-sesv2": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.2",
    "@scalar/fastify-api-reference": "^1.74.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bullmq": "^6.3.15",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@aggregator-dpg/tsconfig": "workspace:*",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
