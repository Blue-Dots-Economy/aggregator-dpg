{
  "name": "@aggregator-dpg/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint --no-warn-ignored .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "spec:dump": "tsx scripts/dump-openapi.ts"
  },
  "dependencies": {
    "@aggregator-dpg/campaign-template": "workspace:*",
    "@aggregator-dpg/config-loader": "workspace:*",
    "@aggregator-dpg/consent-ledger": "workspace:*",
    "@aggregator-dpg/db-schema": "workspace:*",
    "@aggregator-dpg/mailer": "workspace:*",
    "@aggregator-dpg/network-config": "workspace:*",
    "@aggregator-dpg/participants-writer": "workspace:*",
    "@aggregator-dpg/profile-csv": "workspace:*",
    "@aggregator-dpg/queue": "workspace:*",
    "@aggregator-dpg/schema-loader": "workspace:*",
    "@aggregator-dpg/shared-primitives": "workspace:*",
    "@aggregator-dpg/signalstack-writer": "workspace:*",
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/client-sesv2": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^8.0.1",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@scalar/fastify-api-reference": "^1.66.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bullmq": "^6.3.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@aggregator-dpg/tsconfig": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
