# ─── Aggregator Worker (BullMQ) — local-dev environment template ────────────
# Copy to apps/worker/.env and edit values. Loaded by `pnpm dev`
# (tsx --env-file=.env).
#
# Defaults are a COMPLETE, working set for aggregator-dpg's OWN standalone dev
# compose (Postgres on host :5433). Running the unified local-setup stack
# instead? See local-setup/LOCAL_SETUP.md §6, Step 3 for the few values that
# differ (Postgres :5432/dpg + SignalStack wiring).

# ── Server
NODE_ENV=development
LOG_LEVEL=info

# ── Postgres (standalone compose maps host 5433 → container 5432)
DATABASE_URL=postgres://aggregator:aggregator-dev@localhost:5433/aggregator

# ── Redis (BullMQ queues + scheduler)
REDIS_URL=redis://localhost:6379

# ── Object storage (bulk uploads + errors.csv + campaign export). Dev = MinIO on localhost:9000.
S3_ENDPOINT=http://localhost:9000
# Browser-reachable S3 host used ONLY to mint pre-signed export links (the
# download link is clicked in a browser/email client, which can't resolve an
# internal docker host). Falls back to S3_ENDPOINT when unset — fine for dev.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=aggregator-bulk-uploads
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ── Config-as-code (network-scoped). Paths are relative to the app dir
# (apps/worker) — the CWD when you run `pnpm --filter @aggregator-dpg/worker
# dev` — so `../../config` reaches the repo-root config/. (Docker overrides to
# the absolute /app/config path.)
SCHEMA_ROOT_DIR=../../config/blue_dot/schemas
AGGREGATOR_CONFIG_PATH=../../config/blue_dot/aggregator.config.yaml

# ── SignalStack outward push (participant onboarding → signals-dpg).
# Leave SIGNALSTACK_BASE_URL blank to run standalone (push disabled). To enable,
# set the base URL AND the admin key from the signals-dpg service seed
# (db:seed:services). The worker onboards participants, so — unlike the API — it
# needs no acting-org id (the org is derived per row).
SIGNALSTACK_BASE_URL=
SIGNALSTACK_ADMIN_KEY=
SIGNALSTACK_ITEM_NETWORK=blue_dot

# ── Campaign PII export (aggregator-dpg#579) ─────────────────────────────────
# The `export` worker role decrypts the requested items' contact fields
# (name/email/phone), writes a CSV to S3, and emails a pre-signed download link
# to the REQUESTING AGGREGATOR (resolved by the API from its token — there is no
# admin-recipient env). Requires SIGNALSTACK_* (above) + the mailer (below).
# EXPORT_URL_TTL_SECONDS=86400          # pre-signed export-link TTL (seconds)
# CAMPAIGN_CONCURRENCY=2        # parallel campaign-process jobs per process
# CAMPAIGN_DECRYPT_CHUNK=500           # items per Signals decrypt chunk + heartbeat cadence
# CAMPAIGN_EXPORT_FIELDS=contact       # contact = name/email/phone; full = whole item_state
# CAMPAIGN_STALL_SECONDS=900           # processing job idle this long → failed:stalled (watchdog)
# CAMPAIGN_EXPORT_RECIPIENT=requester  # requester (default) | network_admin
# EXPORT_NETWORK_ADMIN_EMAIL=          # recipient when CAMPAIGN_EXPORT_RECIPIENT=network_admin

# ── Mailer (the export job sends the download link). Dev = MailHog / Mailpit on
# localhost:1025. For AWS SES: MAIL_PROVIDER=ses + AWS_REGION + SES_FROM.
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@bluedots.local

# ── Optional tuning (sensible defaults applied when unset) ───────────────────
# WORKER_ROLES: comma-separated subset of file,row,finalise,cron,export (default: all).
# WORKER_ROLES=all
# BULK_MAX_ROWS=10000
# BULK_MAX_ROW_BYTES=65536
# LINK_METRICS_ROLLUP_INTERVAL_MS=60000
# WATCHDOG_INTERVAL_MS=3600000

# ── Campaign voice channel (#577) ───────────────────────────────────────
# Raya voice provider configuration. RAYA_API_KEY is optional and asserted
# lazily when the voice campaign job runs (asserts CAMPAIGN_VOICE_PROVIDER=raya).
CAMPAIGN_VOICE_PROVIDER=raya
RAYA_BASE_URL=https://v1.getraya.app/api
# RAYA_API_KEY=                          # set when using the Raya provider
RAYA_TIMEOUT_MS=15000                   # HTTP timeout for Raya calls (ms)
RAYA_EGRESS_WINDOW_SECONDS=20           # rate-limit window for Raya calls
RAYA_EGRESS_MAX=1                       # max Raya calls per window

BULK_UPLOAD_REDIS_TTL_SECONDS=86400   # TTL on bu:{id}:* working keys (raw CSV + per-row PII); self-expiry backstop
