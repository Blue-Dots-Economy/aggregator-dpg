{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bluedots.org/aggregator/registration.v1.json",
  "title": "Aggregator Registration",
  "description": "Signup payload for a new Aggregator account. Captures only the identity, contact, optional locations, and consent needed to create a Keycloak user and let the aggregator log in. Personas, services, verified certificates, and the contact-name label are filled in afterwards through the profile-completion flow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "type", "contact", "consent"],
  "properties": {
    "name": {
      "type": "string",
      "title": "Organisation Name",
      "minLength": 2,
      "maxLength": 200,
      "examples": ["SkillBridge Network", "TRRAIN", "Pankh Foundation"],
      "x-ui": {
        "placeholder": "e.g. SkillBridge Network",
        "autofocus": true
      }
    },
    "type": {
      "type": "string",
      "title": "Aggregator Type",
      "enum": ["seeker", "provider"],
      "x-ui": {
        "widget": "select",
        "placeholder": "Select aggregator type",
        "enumNames": ["Seeker", "Provider"]
      }
    },
    "url": {
      "type": "string",
      "title": "Website",
      "format": "uri",
      "maxLength": 2048,
      "examples": ["https://skillbridge.in"],
      "x-updatable": true,
      "x-ui": {
        "placeholder": "https://yourorg.in",
        "options": {
          "inputType": "url"
        }
      }
    },
    "locations": {
      "type": "array",
      "title": "Location",
      "maxItems": 1,
      "x-updatable": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["geo", "address"],
        "properties": {
          "geo": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "coordinates"],
            "default": {
              "type": "Point",
              "coordinates": [0, 0]
            },
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "Point",
                  "LineString",
                  "Polygon",
                  "MultiPoint",
                  "MultiLineString",
                  "MultiPolygon",
                  "GeometryCollection"
                ],
                "default": "Point",
                "x-ui": {
                  "widget": "hidden"
                }
              },
              "coordinates": {
                "type": "array",
                "default": [0, 0],
                "x-ui": {
                  "widget": "hidden"
                }
              }
            },
            "x-ui": {
              "widget": "hidden",
              "title": ""
            }
          },
          "address": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "streetAddress": {
                "type": "string",
                "title": "Street",
                "x-ui": {
                  "placeholder": "Street"
                }
              },
              "addressLocality": {
                "type": "string",
                "title": "City",
                "x-ui": {
                  "placeholder": "City"
                }
              },
              "addressRegion": {
                "type": "string",
                "title": "State",
                "x-ui": {
                  "placeholder": "State"
                }
              },
              "postalCode": {
                "type": "string",
                "title": "PIN code",
                "x-ui": {
                  "placeholder": "PIN"
                }
              },
              "addressCountry": {
                "type": "string",
                "title": "Country",
                "minLength": 1,
                "x-ui": {
                  "placeholder": "India"
                }
              }
            },
            "x-form-layout": {
              "layout": "grid",
              "order": [
                "streetAddress",
                "addressLocality",
                "addressRegion",
                "postalCode",
                "addressCountry"
              ]
            },
            "x-ui": {
              "title": ""
            }
          }
        },
        "x-form-layout": {
          "layout": "stack",
          "order": ["address", "geo"]
        },
        "x-ui": {
          "title": ""
        }
      },
      "x-ui": {
        "options": {
          "addable": true,
          "removable": true,
          "orderable": false,
          "itemLabel": "Location"
        }
      }
    },
    "contact": {
      "type": "object",
      "title": "Primary Contact",
      "additionalProperties": false,
      "required": ["name", "phone", "email"],
      "properties": {
        "name": {
          "type": "string",
          "title": "Contact Name",
          "minLength": 2,
          "maxLength": 200,
          "examples": ["Rajesh Kumar"],
          "x-ui": {
            "placeholder": "Full name of the primary contact"
          }
        },
        "phone": {
          "type": "string",
          "title": "Phone",
          "pattern": "^(\\+?\\d{10,15}|\\d{10})$",
          "examples": ["+919876543210", "9876543210"],
          "x-ui": {
            "placeholder": "+91 98765 43210",
            "options": {
              "inputType": "tel"
            }
          }
        },
        "email": {
          "type": "string",
          "title": "Email",
          "format": "email",
          "maxLength": 320,
          "examples": ["admin@skillbridge.in"],
          "x-ui": {
            "placeholder": "admin@yourorg.in",
            "options": {
              "inputType": "email"
            }
          }
        }
      },
      "x-form-layout": {
        "layout": "grid",
        "order": ["name", "phone", "email"]
      }
    },
    "consent": {
      "type": "object",
      "title": "Terms & Privacy Consent",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {
          "type": "boolean",
          "title": "I have read and accept the terms and privacy policy",
          "x-ui": {
            "widget": "ConsentCheckbox"
          }
        },
        "given_at": {
          "type": "string",
          "format": "date-time",
          "x-ui": {
            "widget": "hidden",
            "options": {
              "label": false
            }
          }
        },
        "valid_till": {
          "type": "string",
          "format": "date-time",
          "x-ui": {
            "widget": "hidden",
            "options": {
              "label": false
            }
          }
        }
      },
      "x-form-layout": {
        "layout": "stack",
        "order": ["value", "given_at", "valid_till"]
      }
    }
  },
  "x-form-layout": {
    "layout": "stack",
    "order": ["name", "type", "url", "contact", "locations", "consent"]
  }
}
