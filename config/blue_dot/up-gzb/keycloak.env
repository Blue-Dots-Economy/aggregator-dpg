# Brand strings for the Keycloak login page + realm displayName, UP-GZB rollout.
# Selected by `build-theme-image.sh blue_dot up-gzb` (or the "Keycloak Theme"
# workflow with brand=up-gzb), which reads config/<network>/<brand>/keycloak.env
# INSTEAD of the network file — so this is a COMPLETE file, not an overlay.
#
# Identical to config/blue_dot/keycloak.env except BRAND_LOGO_SLUG, which points
# at the refreshed Blue Dots lockup in the theme's img/brand/up-gzb/ folder.
BRAND_SHORT_NAME=Blue Dots
BRAND_LONG_NAME=Blue Dots Aggregator Portal
BRAND_SSO_LABEL=SSO
BRAND_LOGO_SLUG=up-gzb
# Render the refreshed lockup on the hero panel instead of the wordmark text.
# The on-brand variant is the white-text one — the hero panel is dark. That
# artwork already reads "Seeded by EkStep", so BRAND_SEEDED_BY is blanked rather
# than stating the strapline twice in two different wordings.
BRAND_HERO_LOGO=logo-on-brand.png
BRAND_SEEDED_BY=
HERO_TITLE_LEAD=Connecting
HERO_TITLE_HIGHLIGHT=opportunity seekers
HERO_TITLE_TAIL=with the right doors.
HERO_SUBTITLE=A unified network where aggregators, providers, and seekers move together — every blue dot is a person, an opportunity, a path forward.

# Typography from brand.json.typography. PDF specifies Arial.
BRAND_FONT_SANS=Arial, system-ui, sans-serif
BRAND_FONT_HEADING=Arial, system-ui, sans-serif
BRAND_FONT_BODY=Arial, system-ui, sans-serif

# Canonical Blue Dots palette from the brand guidelines.
BRAND_PRIMARY_COLOR=#0074ff
BRAND_PRIMARY_DARK=#005ecc
BRAND_PRIMARY_500=#57abff
BRAND_PRIMARY_100=#cfe6ff
BRAND_PRIMARY_50=#e6f0ff

# Logo slug for the SIGNALS login page (signals child theme). Must match
# BRAND_LOGO_SLUG above — see themes.Dockerfile.
SIGNALS_BRAND_LOGO_SLUG=up-gzb
