BRAND_SHORT_NAME=Purple Dots
BRAND_LONG_NAME=Purple Dot Aggregator Portal
BRAND_SSO_LABEL=SSO
BRAND_LOGO_SLUG=purple-dot
# Hero-panel lockup on the login page — renders the on-brand (white-text) logo
# on the purple panel instead of the wordmark + strapline text. purple-dot
# ships logo-on-brand.png; read at runtime by theme.properties (no rebuild).
BRAND_HERO_LOGO=logo-on-brand.png
HERO_TITLE_LEAD=Welcome to
HERO_TITLE_HIGHLIGHT=Purple Dots
HERO_TITLE_TAIL=discovery & services for people with disabilities.
HERO_SUBTITLE=Sign in to manage seekers, service providers, and onboarding across the network.

# Typography from brand.json.typography. PDF specifies Arial.
BRAND_FONT_SANS=Arial, system-ui, sans-serif
BRAND_FONT_HEADING=Arial, system-ui, sans-serif
BRAND_FONT_BODY=Arial, system-ui, sans-serif

# Canonical Purple Dots palette from the brand guidelines.
BRAND_PRIMARY_COLOR=#4c29c3
BRAND_PRIMARY_DARK=#3a1ea0
BRAND_PRIMARY_500=#8d3add
BRAND_PRIMARY_100=#e9ddff
BRAND_PRIMARY_50=#f4eeff

# Sign-off line on the Keycloak login-OTP email (#626). Baked into the theme
# image by themes.Dockerfile; changing it needs a rebuild, not a config reload.
EMAIL_SIGNOFF=Team ALIMCO
