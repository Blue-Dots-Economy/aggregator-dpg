{
  "ui:layout": "stack",
  "ui:order": [
    "display_name",
    "website",
    "aggregator_type",
    "organisation_type",
    "address",
    "state",
    "owner",
    "consent"
  ],
  "display_name": {
    "ui:placeholder": "e.g. Enable India",
    "ui:autofocus": true
  },
  "state": {
    "ui:widget": "hidden",
    "ui:options": {
      "label": false
    }
  },
  "owner": {
    "ui:layout": "grid",
    "ui:order": ["name", "phone", "email"],
    "name": {
      "ui:placeholder": "Full name of the organisation owner"
    },
    "phone": {
      "ui:placeholder": "+91 98765 43210",
      "ui:options": {
        "inputType": "tel"
      }
    },
    "email": {
      "ui:placeholder": "owner@yourorg.org",
      "ui:options": {
        "inputType": "email"
      }
    }
  },
  "consent": {
    "ui:layout": "stack",
    "ui:order": ["value", "given_at", "valid_till"],
    "value": {
      "ui:widget": "ConsentCheckbox"
    },
    "given_at": {
      "ui:widget": "hidden",
      "ui:options": {
        "label": false
      }
    },
    "valid_till": {
      "ui:widget": "hidden",
      "ui:options": {
        "label": false
      }
    }
  },
  "website": {
    "ui:placeholder": "https://yourorg.org",
    "ui:options": {
      "inputType": "url"
    }
  },
  "aggregator_type": {
    "ui:enumNames": ["Seekers", "Service Providers"]
  },
  "address": {
    "ui:layout": "grid",
    "ui:order": [
      "streetAddress",
      "addressLocality",
      "addressDistrict",
      "addressRegion",
      "postalCode",
      "addressCountry"
    ],
    "streetAddress": {
      "ui:placeholder": "Street, Area"
    },
    "addressLocality": {
      "ui:placeholder": "City"
    },
    "addressDistrict": {
      "ui:placeholder": "District"
    },
    "addressRegion": {
      "ui:placeholder": "State"
    },
    "postalCode": {
      "ui:placeholder": "PIN"
    },
    "addressCountry": {
      "ui:placeholder": "India"
    }
  },
  "organisation_type": {
    "ui:widget": "select",
    "ui:placeholder": "Select organisation type",
    "ui:enumNames": ["NGO", "Government Entity", "Private Company", "Community Group", "Others"]
  }
}
