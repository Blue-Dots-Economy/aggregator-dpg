{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bluedots.org/aggregator/org-registration.v1.json",
  "title": "Organisation Registration",
  "description": "Signup payload for a new parent organisation (spec §6.1). Captures the org display name, optional state, the org owner's contact identity, and consent. The URL slug is generated by the server at submit and is not supplied by the client. Coordinators register separately and select an approved org.",
  "type": "object",
  "additionalProperties": false,
  "required": ["display_name", "aggregator_type", "organisation_type", "owner", "consent"],
  "properties": {
    "display_name": {
      "type": "string",
      "title": "Organisation Name",
      "minLength": 2,
      "maxLength": 200,
      "examples": ["ABC Limited", "XYZ Foundation"]
    },
    "website": {
      "type": "string",
      "title": "Website",
      "pattern": "^https://[^\\s/?#]+\\.[A-Za-z]{2,}(?::\\d{1,5})?(?:[/?#]\\S*)?$",
      "x-error-message": "Please enter a website starting with https://",
      "maxLength": 2048,
      "description": "Not required at signup; can be added or edited later.",
      "examples": ["https://abclimited.org"],
      "x-updatable": true
    },
    "gst_number": {
      "type": "string",
      "title": "GST number",
      "maxLength": 15,
      "pattern": "^[0-9]{2}[A-Za-z]{5}[0-9]{4}[A-Za-z][1-9A-Za-z][Zz][0-9A-Za-z]$",
      "x-error-message": "Please enter a valid GSTIN.",
      "x-check": "gstin",
      "examples": ["29ABCDE1234F1ZW"],
      "x-updatable": true
    },
    "aggregator_type": {
      "type": "array",
      "title": "Aggregator Type",
      "description": "Which participants this organisation represents. Captured as information only — it does not restrict what its coordinators can do.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["seeker", "provider"]
      },
      "examples": [["seeker"], ["provider"], ["seeker", "provider"]]
    },
    "organisation_type": {
      "type": "string",
      "title": "Organisation Type",
      "description": "The broad category that describes your organisation.",
      "enum": ["ngo", "government_entity", "private_company", "community_group", "other"]
    },
    "address": {
      "type": "object",
      "title": "Address",
      "additionalProperties": false,
      "properties": {
        "streetAddress": {
          "type": "string",
          "title": "Address",
          "maxLength": 500
        }
      }
    },
    "owner": {
      "type": "object",
      "title": "Organisation Owner",
      "additionalProperties": false,
      "required": ["name", "phone", "email"],
      "properties": {
        "name": {
          "type": "string",
          "title": "Owner Name",
          "minLength": 2,
          "maxLength": 200,
          "examples": ["Rajesh Kumar"]
        },
        "phone": {
          "type": "string",
          "title": "Phone",
          "pattern": "^(\\+91[6-9][0-9]{9}|[6-9][0-9]{9}|\\+[1-8][0-9]{9,14}|\\+9[02-9][0-9]{8,13})$",
          "examples": ["+919876543210", "9876543210"]
        },
        "email": {
          "type": "string",
          "title": "Email",
          "format": "email",
          "maxLength": 320,
          "examples": ["owner@abclimited.org"]
        }
      }
    },
    "consent": {
      "type": "object",
      "title": "Terms & Privacy Consent",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {
          "type": "boolean",
          "title": "I have read and accept the terms and privacy policy"
        },
        "given_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_till": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
