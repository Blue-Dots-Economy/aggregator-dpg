{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bluedots.org/aggregator/org-registration.v1.json",
  "title": "Organisation Registration",
  "description": "Signup payload for a new parent organisation (spec §6.1). Captures the org display name, optional state, the org owner's contact identity, and consent. The URL slug is generated by the server at submit and is not supplied by the client. Coordinators register separately and select an approved org.",
  "type": "object",
  "additionalProperties": false,
  "required": ["display_name", "aggregator_type", "organisation_type", "owner", "consent"],
  "properties": {
    "display_name": {
      "type": "string",
      "title": "Organisation Name",
      "minLength": 2,
      "maxLength": 200,
      "examples": ["ABC Limited", "XYZ Foundation"],
      "x-rjsf": {
        "placeholder": "e.g. ABC Limited",
        "autofocus": true
      }
    },
    "website": {
      "type": "string",
      "title": "Website",
      "format": "uri",
      "maxLength": 2048,
      "description": "Not required at signup; can be added or edited later.",
      "examples": ["https://abclimited.org"],
      "x-updatable": true,
      "x-rjsf": {
        "placeholder": "https://yourorg.org",
        "options": {
          "inputType": "url"
        }
      }
    },
    "aggregator_type": {
      "type": "array",
      "title": "Aggregator Type",
      "description": "Which participants this organisation represents. Captured as information only — it does not restrict what its coordinators can do.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["seeker", "provider"]
      },
      "examples": [["seeker"], ["provider"], ["seeker", "provider"]],
      "x-rjsf": {
        "enumNames": ["Seekers", "Service Providers"]
      }
    },
    "organisation_type": {
      "type": "string",
      "title": "Organisation Type",
      "description": "The broad category that describes your organisation.",
      "enum": ["ngo", "government_entity", "private_company", "community_group", "other"],
      "x-rjsf": {
        "widget": "select",
        "placeholder": "Select organisation type",
        "enumNames": ["NGO", "Government Entity", "Private Company", "Community Group", "Others"]
      }
    },
    "address": {
      "type": "object",
      "title": "Address",
      "description": "Street onwards for the organisation.",
      "additionalProperties": false,
      "properties": {
        "streetAddress": {
          "type": "string",
          "title": "Street",
          "maxLength": 300,
          "x-rjsf": {
            "placeholder": "Street, Area"
          }
        },
        "addressLocality": {
          "type": "string",
          "title": "City",
          "maxLength": 200,
          "x-rjsf": {
            "placeholder": "City"
          }
        },
        "addressDistrict": {
          "type": "string",
          "title": "District",
          "maxLength": 200,
          "x-rjsf": {
            "placeholder": "District"
          }
        },
        "addressRegion": {
          "type": "string",
          "title": "State",
          "maxLength": 200,
          "x-rjsf": {
            "placeholder": "State"
          }
        },
        "postalCode": {
          "type": "string",
          "title": "PIN code",
          "maxLength": 20,
          "x-rjsf": {
            "placeholder": "PIN"
          }
        },
        "addressCountry": {
          "type": "string",
          "title": "Country",
          "maxLength": 100,
          "x-rjsf": {
            "placeholder": "India"
          }
        }
      },
      "x-rjsf": {
        "layout": "grid",
        "order": [
          "streetAddress",
          "addressLocality",
          "addressDistrict",
          "addressRegion",
          "postalCode",
          "addressCountry"
        ]
      }
    },
    "state": {
      "type": "string",
      "title": "State",
      "description": "Derived from the address block on this instance; not asked for separately.",
      "maxLength": 200,
      "x-rjsf": {
        "widget": "hidden",
        "options": {
          "label": false
        }
      }
    },
    "owner": {
      "type": "object",
      "title": "Organisation Owner",
      "additionalProperties": false,
      "required": ["name", "phone", "email"],
      "properties": {
        "name": {
          "type": "string",
          "title": "Owner Name",
          "minLength": 2,
          "maxLength": 200,
          "examples": ["Rajesh Kumar"],
          "x-rjsf": {
            "placeholder": "Full name of the organisation owner"
          }
        },
        "phone": {
          "type": "string",
          "title": "Phone",
          "pattern": "^(\\+?\\d{10,15}|\\d{10})$",
          "examples": ["+919876543210", "9876543210"],
          "x-rjsf": {
            "placeholder": "+91 98765 43210",
            "options": {
              "inputType": "tel"
            }
          }
        },
        "email": {
          "type": "string",
          "title": "Email",
          "format": "email",
          "maxLength": 320,
          "examples": ["owner@abclimited.org"],
          "x-rjsf": {
            "placeholder": "owner@yourorg.org",
            "options": {
              "inputType": "email"
            }
          }
        }
      },
      "x-rjsf": {
        "layout": "grid",
        "order": ["name", "phone", "email"]
      }
    },
    "consent": {
      "type": "object",
      "title": "Terms & Privacy Consent",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {
          "type": "boolean",
          "title": "I have read and accept the terms and privacy policy",
          "x-rjsf": {
            "widget": "ConsentCheckbox"
          }
        },
        "given_at": {
          "type": "string",
          "format": "date-time",
          "x-rjsf": {
            "widget": "hidden",
            "options": {
              "label": false
            }
          }
        },
        "valid_till": {
          "type": "string",
          "format": "date-time",
          "x-rjsf": {
            "widget": "hidden",
            "options": {
              "label": false
            }
          }
        }
      },
      "x-rjsf": {
        "layout": "stack",
        "order": ["value", "given_at", "valid_till"]
      }
    }
  },
  "x-rjsf": {
    "layout": "stack",
    "order": [
      "display_name",
      "website",
      "aggregator_type",
      "organisation_type",
      "address",
      "state",
      "owner",
      "consent"
    ]
  }
}
