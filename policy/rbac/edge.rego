# Route-level access decisions at the edge (Envoy ext_authz) for aggregator-dpg.
#
# Query: the opa-envoy-plugin evaluates data.rbac.edge.decision for every
# request, before it reaches the API (docs/rbac/rbac-edge-enforcement.md).
#
# Inputs:
#   input.attributes.request.http   method, path, headers (Envoy CheckRequest)
#   input.attributes.metadataContext.filterMetadata["envoy.filters.http.jwt_authn"].jwt_payload
#                                   the token Envoy's jwt_authn verified (absent: no token).
#                                   The plugin passes Envoy's CheckRequest in protobuf
#                                   JSON names (camelCase), not the proto field names.
#   data.edge                       the route table, generated by
#                                   `pnpm --filter @aggregator-dpg/api routes:dump`
#   data.catalogue                  { mode, roles: { <key>: { permissions } } },
#                                   pushed by the API (absent until it does)
#
# The question is the API's route-level one: does the caller hold the route's
# permission in any of its organisations. The token's `roles` claim lists role
# keys only, for active memberships only. Per-organisation checks (reach,
# masking, assignment rules) stay in the API.

package rbac.edge

import rego.v1

# ── Request ──────────────────────────────────────────────────────────────────

http := input.attributes.request.http

# HEAD is served by the GET route (Fastify registers it implicitly).
method := "GET" if {
	upper(http.method) == "HEAD"
} else := upper(http.method)

path := split(http.path, "?")[0]

# The path's segments, percent-decoded. Fastify decodes the path before it
# matches static segments (`/v1/rol%65s` is `/v1/roles`), so the edge must too,
# or it would decide an encoded request against a different route. `+` is a
# literal in a path. A segment that does not decode leaves the path unmatched.
segments := decoded if {
	raw := split(path, "/")
	decoded := [urlquery.decode(replace(s, "+", "%2B")) | some s in raw]
	count(decoded) == count(raw)
}

request_id := object.get(object.get(http, "headers", {}), "x-request-id", "")

jwt_payload := input.attributes.metadataContext.filterMetadata["envoy.filters.http.jwt_authn"].jwt_payload

has_token if is_object(jwt_payload)

claims := jwt_payload if {
	has_token
} else := {}

# The claim is a list; tolerate a single value emitted as a string.
roles := {claims.roles} if {
	is_string(claims.roles)
} else := {r | some r in object.get(claims, "roles", [])}

is_service_account if startswith(object.get(claims, "preferred_username", ""), "service-account-")

# ── Mode and catalogue ───────────────────────────────────────────────────────

catalogue_loaded if is_object(data.catalogue.roles)

# Fail closed: without a pushed mode the edge enforces.
default mode := "enforce"

mode := data.catalogue.mode if data.catalogue.mode in {"off", "log", "enforce"}

permissions := {p |
	catalogue_loaded
	some r in roles
	some p in object.get(data.catalogue.roles, r, {"permissions": []}).permissions
}

# ── Route lookup ─────────────────────────────────────────────────────────────

unchecked if {
	some prefix in data.edge.unchecked_prefixes
	startswith(path, prefix)
}

segment_matches(t, s) if t == s

segment_matches(t, s) if {
	startswith(t, ":")
	s != ""
}

param_bit(t) := "1" if {
	startswith(t, ":")
} else := "0"

# Fastify prefers a static segment to a parameter at the first position where
# two routes differ, so key each candidate by its parameter pattern ("0" =
# static, "1" = parameter) and take the lowest.
candidates[shape] := r if {
	some r in data.edge.routes
	r.method == method
	tpl := split(r.path, "/")
	segs := segments
	count(tpl) == count(segs)
	every i, t in tpl {
		segment_matches(t, segs[i])
	}
	shape := concat("", [param_bit(t) | some t in tpl])
}

route := candidates[sort(object.keys(candidates))[0]] if count(candidates) > 0

route_found if route

route_path := route.path if {
	route_found
} else := ""

# ── Decision ─────────────────────────────────────────────────────────────────

# Why the request would be refused, as { status, code, permission }.
denial := {"status": 404, "code": "NOT_FOUND", "permission": ""} if {
	not unchecked
	not route_found
} else := access_denial(route.access) if {
	route_found
}

access_denial(a) := {"status": 401, "code": "UNAUTHORIZED", "permission": label(a)} if {
	not open_access(a)
	not has_token
} else := {"status": 403, "code": "FORBIDDEN", "permission": "service"} if {
	a.access == "service"
	not is_service_account
} else := {"status": 403, "code": "FORBIDDEN", "permission": a.access} if {
	a.access in {"signed_in", "self"}
	count(roles) == 0
} else := {"status": 403, "code": "FORBIDDEN", "permission": a.capability} if {
	cap := a.capability
	not cap in permissions
} else := {"status": 403, "code": "FORBIDDEN", "permission": concat("|", a.anyCapability)} if {
	caps := a.anyCapability
	count({c | some c in caps; c in permissions}) == 0
}

# Routes anyone may call: the API checks a signed link, or nothing.
open_access(a) if a.access in {"public", "link_token"}

label(a) := a.capability if {
	a.capability
} else := concat("|", a.anyCapability) if {
	a.anyCapability
} else := a.access

denied if denial

strict if route.access.strict == true

# `strict` routes did not exist before RBAC and refuse in `log` mode too.
refused if {
	denied
	mode == "enforce"
}

refused if {
	denied
	mode == "log"
	strict
}

outcome := "deny" if {
	refused
} else := "would_deny" if {
	denied
} else := "allow"

# ── Response ─────────────────────────────────────────────────────────────────

texts := {
	401: ["Sign-in required", "Your session is missing or invalid. Please sign in again."],
	403: ["Access denied", "You do not have permission to perform this action."],
	404: ["Not found", "The requested resource does not exist."],
}

error_fields := {"fields": {"permission": denial.permission}} if {
	denial.permission != ""
} else := {}

# The API's error envelope (apps/api/src/errors/serialize.ts), so the web BFF
# and the UI read an edge refusal like an API one.
error_body := json.marshal({"error": object.union(
	{
		"code": denial.code,
		"title": texts[denial.status][0],
		"detail": texts[denial.status][1],
		"requestId": request_id,
		"timestamp": time.format([time.now_ns(), "UTC", "2006-01-02T15:04:05.000Z07:00"]),
	},
	error_fields,
)})

# Recorded with every decision (Envoy dynamic metadata, OPA decision logs).
metadata := {"rbac_edge": object.union(
	{"outcome": outcome, "mode": mode, "route": route_path},
	denial_metadata,
)}

denial_metadata := {"code": denial.code, "permission": denial.permission} if {
	denied
} else := {}

decision := {
	"allowed": false,
	"http_status": denial.status,
	"headers": {"content-type": "application/json", "x-request-id": request_id},
	"body": error_body,
	"dynamic_metadata": metadata,
} if {
	refused
} else := {"allowed": true, "dynamic_metadata": metadata}
