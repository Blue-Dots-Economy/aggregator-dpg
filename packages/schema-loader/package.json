{
  "name": "@aggregator-dpg/schema-loader",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./interface": {
      "import": "./dist/interface.js",
      "types": "./dist/interface.d.ts"
    },
    "./file": {
      "import": "./dist/file-loader.js",
      "types": "./dist/file-loader.d.ts"
    },
    "./testing": {
      "import": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aggregator-dpg/shared-primitives": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@aggregator-dpg/tsconfig": "workspace:*",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
