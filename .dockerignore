# ── Version control ───────────────────────────────────────────────────────────
.git/
.gitignore

# ── Dependencies (reinstalled fresh inside image) ─────────────────────────────
**/node_modules/
.pnpm-store/

# ── Build outputs (rebuilt inside image) ──────────────────────────────────────
**/dist/
build/
out/
**/.next/
.nuxt/
.svelte-kit/

# ── TypeScript ────────────────────────────────────────────────────────────────
**/*.tsbuildinfo
*.d.ts.map

# ── Cache ─────────────────────────────────────────────────────────────────────
**/.turbo/
.cache/
.eslintcache
.prettiercache
.parcel-cache/

# ── Test & coverage ───────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# ── Environment ───────────────────────────────────────────────────────────────
# `**/` because patterns are anchored to the context root: a bare `.env` misses
# apps/*/.env (Track B creates them), whose secrets would be copied into the
# image and, for apps/web, read by `next build`.
**/.env
**/.env.*

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db

# ── Dev tooling (not needed at runtime) ───────────────────────────────────────
.husky/
.changeset/
.claude/
.github/
.vscode/
.idea/

# ── Docs & config files ───────────────────────────────────────────────────────
docs/
*.md
!**/README.md
.eslintrc*
eslint.config.*
prettier.config.*
commitlint.config.*
